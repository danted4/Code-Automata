{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the app's own commands, nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-pick-folder",
    "allow-pick-file",
    "allow-available-editors",
    "allow-path-exists",
    "allow-open-in-editor",
    "allow-reveal-folder",
    "allow-get-app-settings",
    "allow-set-app-settings",
    "allow-check-for-updates",
    "allow-smoke-report"
  ]
}
