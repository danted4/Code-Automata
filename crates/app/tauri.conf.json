{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code-Automata",
  "identifier": "com.code-automata.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "yarn dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "yarn build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "AI coding agents on a Kanban board, one git worktree per task",
    "copyright": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": ["git"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5RTlDMTY3MkQ0Q0ZCMTEKUldRUiswd3RaOEhwMmFwdHozUVZVNmZtSER0Qkt5L0g4bDkxaHh3bzZVdkdlWlpXbERDVVlDN2YK",
      "endpoints": ["https://github.com/danted4/Code-Automata/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
